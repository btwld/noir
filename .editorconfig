# EditorConfig for Noir
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Dart source files
[*.dart]
indent_size = 2
max_line_length = 80

# YAML configuration files
[*.{yaml,yml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 100

# Shell scripts
[*.sh]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Git configuration
[.git*]
indent_size = 4
