# Configure OpenTUI dynamic library discovery for Dart FFI
# If you installed via the system installer, you likely don’t need this.
# Otherwise set to the absolute path of the native library.

# macOS (Apple Silicon / Homebrew)
# OPENTUI_LIBRARY_PATH=/opt/homebrew/lib/libopentui.dylib

# macOS (Intel / default)
# OPENTUI_LIBRARY_PATH=/usr/local/lib/libopentui.dylib

# Linux
# OPENTUI_LIBRARY_PATH=/usr/local/lib/libopentui.so

# Windows
# OPENTUI_LIBRARY_PATH=C:\\path\\to\\opentui.dll
