# noir package - pub ignore rules
# Excludes development files and build artifacts from the published package.

# Local workspace state
.agents/
.claude/
.augment-guidelines
.editorconfig
.gitattributes
.context/
.conductor/
/skills/

# Optional companion package published separately as `noir_signals`.
# Pub applies this rule to nested packages too, so the companion is published
# from a copy staged outside this checkout by
# `scripts/stage_companion_package.dart`.
/packages/

# Development and build tools
.github/
/scripts/
/tools/
/website/
/.impeccable/

# External dependencies and submodules
/external/

# Build artifacts and temporary files
*.tar.gz
*.tgz
*.zip
build/
.dart_tool/cache/
.dart_tool/package_config_subset

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs and debug files
*.log
debug.log

# Git specific
.git/
.gitmodules
.gitignore

# Generated documentation and repository guides not needed in package
/doc/api/
/docs/
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
GOALS.md
TODO.md

# Tests are not part of the published package
test/
coverage/
.lcov

# Keep packaged native binaries and native_manifest.json.

# Codegen and test configuration (development-only)
FFIGEN.md
ffigen_dynamic.yaml
ffigen_native_assets.yaml
dart_test.yaml
