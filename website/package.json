{
  "name": "noir-website",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "zod": "4.3.6"
  },
  "scripts": {
    "build": "node scripts/highlight-homepage.mjs && next build",
    "dev": "node scripts/highlight-homepage.mjs && next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "node scripts/highlight-homepage.mjs && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.3",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
